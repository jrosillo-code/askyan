# ── Askya Expeditions — environment ──────────────────────────────────────────
# Copy to .env for local dev; set these in the hosting provider for production.

# Postgres connection string (required — waitlist, contact form, analytics).
# NOTE: on Replit this was auto-injected; it is NOT among the exported secrets.
# Get it from Replit → Database tool, or provision a fresh Postgres
# (Supabase/Neon) and run `npm run db:push` to create the tables.
DATABASE_URL=

# AI concierge chat (optional — /api/chat returns a friendly 503 without it).
# On Replit this ran through their internal proxy with a dummy key; off-platform
# it needs a real OpenAI API key.
OPENAI_API_KEY=

# Express session signing secret (scaffolding — sessions not currently used).
# Generate a fresh one: openssl rand -base64 64
SESSION_SECRET=
